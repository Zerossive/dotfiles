#!/usr/bin/env bash
# ==============================================================================
# Script Name: info
# Description: print general help information
# Usage: info
# Author: Danny Harris
# Dependencies: bat
# ==============================================================================

# ------------------------------- 80 chars max ------------------------------- #
output=$(
	cat <<'EOF' | fold -w 80
▁▁▁▁▁▁
▏INFO▕
▔▔▔▔▔▔
# GENERAL
**OS:**        Fedora Linux 43
**DE:**        KDE Plasma 6
**IP:**        *ATLAS:* 192.168.1.89
               *OLYMPUS:* 192.168.1.231
               *BOYCE-PC:* 192.168.1.230
               *HERMES:* 192.168.1.232

# TERMINAL TOOLS
`lsblkc`        list block devices
`cdi`           runs zoxide interactive window to fuzzy search directories
`atool`         archiving tool (`-l` list, `-x` extract, `-a` add)
`magick`        image conversion tool (filetypes, sizes, effects, etc.)
`wtf`           print various error logs
`rsyncc`        copy using `rsync -haviP`
	`-n`                       dry-run
	`--update, -u`             skip newer files
	`--ignore-existing`        skip existing files
	`--delete`                 delete destination files
	`--exclude`                exclude based on given pattern
`entr`          run commands when files change e.g. `ls PATH | entr COMMAND`
`remind`        set and list reminder notifications
                e.g. `remind now+15min do task`
`fx`            json viewer and processor

# OTHER NOTABLE COMMANDS
`fkill`, `dysk`, `dnfc`, `color`, `sshs`, `re`, `ipc/ip -4 -brief a`, `ghc/ghcl`, `pastel`, `bacon`, `compgen -c`, `fpw`, `launch`, `pv`

## FUN COMMANDS
`cmatrix/afk`, `cava`, `figlet`, `showfigfonts`

# ALTERNATE PRORGRAMS
`grep` -> `rg`, `find` -> `fd`, `ls` -> `eza`, `cd` -> `z (zoxide)`, `bc` -> `qalc/qc`, `curl` -> `xh`, `diff` -> `delta`

## FISH SHELL
`fish_key_reader`

# OTHER
**awesome-cli-apps**        https://github.com/agarrharr/awesome-cli-apps
EOF
)
# ------------------------------- 80 chars max ------------------------------- #

## check for bat
if command -v bat >/dev/null 2>&1; then
	bat -l md --style plain <<<"$output"
else
	cat <<<"$output"
fi

# vim: set ft=sh:
