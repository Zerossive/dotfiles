#!/usr/bin/env bash
# ==============================================================================
# Script Name: weight
# Description: track weight
# Author: Danny Harris
# ==============================================================================

# set global variables
log_file="$HOME/Syncthing/weight.csv"
current_date="$(date +%Y-%m-%d)"

# exit if log dir doesn't exist
if [[ ! -f "$log_file" ]]; then
    printf "%s\n" "error: file doesn't exist: $log_file" >&2
    exit 1
fi

# if no arguments, edit file
if [ $# -eq 0 ]; then
    nvim "$log_file" -c "norm G"
    exit 0
fi

# show help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<-EOF
		Usage: ${0##*/} [<weight>]
		Create or view weight logs.
	EOF
    exit 0
fi

# if remaining arguments, use them as value for log
if [ $# -gt 0 ]; then
    # check if decimal
    if [[ ! "$*" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf "error: argument not a decimal number: %s\n" "$*" >&2
        exit 1
    fi
    printf "%s,%s\n" "$current_date" "$*" >>$log_file
    tail --lines 5 $log_file
fi

# vim: set ft=sh:
